# ==============================================================================
# FINY Environment Variables
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin CMS only. This key BYPASSES all Row Level Security, so it must stay on
# the server: never prefix it with NEXT_PUBLIC_ and never import it from a
# Client Component. Get it from Supabase -> Project Settings -> API ->
# service_role (secret). Used by src/lib/supabase-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI (for OCR receipts & AI Financial Assistant)
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# Midtrans Payment Gateway (Official Sandbox)
# ------------------------------------------------------------------------------
# Server key is used securely on the backend / Supabase Edge Functions.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxx

# Client key is public and used in the frontend browser by Midtrans Snap JS.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxx

# Set to false for Sandbox testing, true for Production.
MIDTRANS_IS_PRODUCTION=false

# Snap JS script URL (Defaults to sandbox if not set)
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
